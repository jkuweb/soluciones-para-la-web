---
/**
 * Blog index — latest 10 published posts.
 */
import Layout from '@/layouts/Layout.astro'
import PostCard from '@/components/blog/PostCard.astro'
import { getLatestPosts } from '@/lib/payload'

const posts = await getLatestPosts(10)
const title = `Blog — ${import.meta.env.TENANT_SLUG || 'Blog'}`
---

<Layout {title}>
  <section>
    <h1>Blog</h1>

    {posts.length === 0 && <p>No hay artículos publicados aún.</p>}

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
      {posts.map((post) => (
        <PostCard
          title={post.title}
          slug={post.slug}
          publishedAt={post.publishedAt}
          heroImage={post.heroImage}
          excerpt={post.excerpt}
          categories={post.categories}
        />
      ))}
    </div>
  </section>
</Layout>
