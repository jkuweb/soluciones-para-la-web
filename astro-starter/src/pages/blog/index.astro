---
/**
 * Blog index — search, filter and paginate all published posts client-side.
 *
 * The server fetches a wider set of posts (default 100) plus the full
 * categories/tags lists, then hands them to <SearchAndFilter /> which does
 * Fuse.js search + chip filters + pagination in vanilla JS. No client fetch.
 */
import Layout from '@/layouts/Layout.astro'
import SearchAndFilter from '@/components/blog/SearchAndFilter.astro'
import { getLatestPosts, getCategories, getTags } from '@/lib/payload'

const [posts, categories, tags] = await Promise.all([
  getLatestPosts(100),
  getCategories(),
  getTags(),
])

const title = `Blog — ${import.meta.env.TENANT_SLUG || 'Blog'}`
---

<Layout {title}>
  <SearchAndFilter posts={posts} categories={categories} tags={tags} />
</Layout>
