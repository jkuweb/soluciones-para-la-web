---
/**
 * Blog index — latest 10 published posts.
 *
 * TODO(PR 3): Replace raw HTML with <PostCard /> component.
 * TODO(PR 3): Add full CSS via PostCard.module.css.
 */
import Layout from '@/layouts/Layout.astro'
import { getLatestPosts, getMediaUrl } from '@/lib/payload'

const posts = await getLatestPosts(10)
const title = `Blog — ${import.meta.env.TENANT_SLUG || 'Blog'}`
---

<Layout {title}>
  <section class="blog-index">
    <h1>Blog</h1>

    {posts.length === 0 && <p>No hay artículos publicados aún.</p>}

    <div class="posts-grid">
      {posts.map((post) => (
        <article class="post-card">
          <a href={`/blog/post/${post.slug}`}>
            {(post.heroImage?.sizes?.card?.url || post.heroImage?.url) && (
              <img
                src={getMediaUrl(post.heroImage.sizes?.card?.url || post.heroImage.url)}
                alt={post.heroImage.alt || post.title}
                loading="lazy"
              />
            )}
            <time datetime={post.publishedAt}>
              {new Date(post.publishedAt).toLocaleDateString('es-AR', {
                year: 'numeric', month: 'long', day: 'numeric',
              })}
            </time>
            <h2>{post.title}</h2>
            {post.excerpt && <p>{post.excerpt}</p>}
            {post.categories && post.categories.length > 0 && (
              <ul aria-label="Categorías">
                {post.categories.map((cat) => <li><a href={`/blog/category/${cat.slug}`}>{cat.title}</a></li>)}
              </ul>
            )}
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>
