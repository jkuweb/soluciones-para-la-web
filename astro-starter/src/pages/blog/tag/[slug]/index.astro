---
/**
 * Tag filter page — posts filtered by tag with ?page=N pagination.
 * SSR-only because pagination uses query params.
 *
 * TODO(PR 3): Replace raw HTML with <PostCard /> component + full CSS.
 */
import Layout from '@/layouts/Layout.astro'
import { getTagBySlug, getPostsByTag, getMediaUrl } from '@/lib/payload'
import type { Tag } from '@/lib/types'

export const prerender = false

const { slug } = Astro.params
const page = Number(Astro.url.searchParams.get('page')) || 1
if (!slug) return Astro.redirect('/404')

const tag: Tag | null = await getTagBySlug(slug)
if (!tag) return Astro.redirect('/404')

const { docs: posts, totalPages } = await getPostsByTag(slug, page, 10)
---

<Layout title={`${tag.title} — Blog`}>
  <section class="filter-page">
    <h1>{tag.title}</h1>

    {posts.length === 0 && <p>No hay artículos con esta etiqueta.</p>}

    <div class="posts-list">
      {posts.map((post) => (
        <article class="post-card">
          <a href={`/blog/post/${post.slug}`}>
            {(post.heroImage?.sizes?.card?.url || post.heroImage?.url) && (
              <img
                src={getMediaUrl(post.heroImage.sizes?.card?.url || post.heroImage.url)}
                alt={post.heroImage.alt || post.title}
                loading="lazy"
              />
            )}
            <time datetime={post.publishedAt}>
              {new Date(post.publishedAt).toLocaleDateString('es-AR', {
                year: 'numeric', month: 'long', day: 'numeric',
              })}
            </time>
            <h2>{post.title}</h2>
            {post.excerpt && <p>{post.excerpt}</p>}
            {post.categories && post.categories.length > 0 && (
              <ul aria-label="Categorías">
                {post.categories.map((cat) => <li><a href={`/blog/category/${cat.slug}`}>{cat.title}</a></li>)}
              </ul>
            )}
          </a>
        </article>
      ))}
    </div>

    {totalPages > 1 && (
      <nav aria-label="Paginación">
        {page > 1 && <a href={`/blog/tag/${slug}?page=${page - 1}`}>Anterior</a>}
        <span>Página {page} de {totalPages}</span>
        {page < totalPages && <a href={`/blog/tag/${slug}?page=${page + 1}`}>Siguiente</a>}
      </nav>
    )}
  </section>
</Layout>
