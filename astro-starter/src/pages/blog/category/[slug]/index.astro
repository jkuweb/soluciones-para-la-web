---
/**
 * Category filter page — posts filtered by category with ?page=N pagination.
 * SSR-only because pagination uses query params.
 */
import Layout from '@/layouts/Layout.astro'
import PostCard from '@/components/blog/PostCard.astro'
import { getCategoryBySlug, getPostsByCategory } from '@/lib/payload'
import type { Category } from '@/lib/types'

export const prerender = false

const { slug } = Astro.params
const page = Number(Astro.url.searchParams.get('page')) || 1
if (!slug) return Astro.redirect('/404')

const category: Category | null = await getCategoryBySlug(slug)
if (!category) return Astro.redirect('/404')

const { docs: posts, totalPages } = await getPostsByCategory(slug, page, 10)
---

<Layout title={`${category.title} — Blog`}>
  <section>
    <h1>{category.title}</h1>

    {posts.length === 0 && <p>No hay artículos en esta categoría.</p>}

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
      {posts.map((post) => (
        <PostCard
          title={post.title}
          slug={post.slug}
          publishedAt={post.publishedAt}
          heroImage={post.heroImage}
          excerpt={post.excerpt}
          categories={post.categories}
        />
      ))}
    </div>

    {totalPages > 1 && (
      <nav aria-label="Paginación">
        {page > 1 && <a href={`/blog/category/${slug}?page=${page - 1}`}>Anterior</a>}
        <span>Página {page} de {totalPages}</span>
        {page < totalPages && <a href={`/blog/category/${slug}?page=${page + 1}`}>Siguiente</a>}
      </nav>
    )}
  </section>
</Layout>
