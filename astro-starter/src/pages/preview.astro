---
// SSR-only route used by the Payload admin live preview iframe.
//
// Security: validates ?secret= against PREVIEW_SECRET. The secret is the
// same one configured in agencia-backend's .env (PREVIEW_SECRET). Anyone
// hitting this route without the secret gets 403.
//
// Behavior: fetches the latest draft of the page (not just published) and
// renders it through the same Layout + BlockRenderer that the static
// [slug].astro page uses, so the admin sees the real client page with its
// own styles, components, and global CSS.
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import BlockRenderer from '@/components/BlockRenderer.astro'
import { getPageBySlugDraft } from '@/lib/payload'

const url = Astro.url
const path = url.searchParams.get('path') || '/'
const secret = url.searchParams.get('secret') || ''
const expected = import.meta.env.PREVIEW_SECRET || ''

if (!expected || secret !== expected) {
  return new Response('Invalid preview secret', { status: 403 })
}

const slug = path.replace(/^\//, '') || 'home'
const page = await getPageBySlugDraft(slug, secret)

if (!page) {
  return new Response('Page not found', { status: 404 })
}

// Origin of the Payload admin (without /api). The admin posts messages from
// this origin, and isDocumentEvent checks event.origin === serverURL.
const payloadApiUrl = import.meta.env.PAYLOAD_API_URL || 'http://localhost:3000/api'
const serverURL = payloadApiUrl.replace(/\/api\/?$/, '')
---

<Layout
  title={page.meta?.title || page.title}
  description={page.meta?.description}
  seo={page.meta}
>
  <BlockRenderer hero={page.hero} layout={page.layout} />
  <div data-payload-server-url={serverURL} hidden />
</Layout>

<script>
  /**
   * Live preview listener (Astro version).
   *
   * Two things were missing in the previous implementation that prevented
   * the preview from updating after the initial load:
   *
   *   1. The `ready` handshake. The Payload admin does NOT emit postMessage
   *      events to the iframe until the iframe announces it is ready. Without
   *      this call, the admin never sends anything and the preview is frozen
   *      on the first render.
   *
   *   2. The correct event type. For a server-side preview that reloads the
   *      page, we must listen for `payload-document-event` (save / autosave /
   *      publish), not `payload-live-preview` (as-you-type form state). The
   *      latter fires on every keystroke with unsaved data that a page
   *      reload cannot pick up — the server only has the last *saved* draft.
   *      isDocumentEvent also validates event.origin === serverURL, which
   *      the previous type-only check skipped.
   *
   * serverURL is passed through a data attribute because Astro bundles
   * <script> tags (so `import` works) but does not expose non-PUBLIC_ env
   * vars to client-side code.
   */
  import { ready, isDocumentEvent } from '@payloadcms/live-preview'

  const serverURL =
    document.querySelector('[data-payload-server-url]')?.getAttribute('data-payload-server-url') || ''

  // Announce to the Payload admin that the iframe is ready to receive events.
  ready({ serverURL })

  // Reload when the admin sends a document-level event (autosave / save /
  // publish). The autosave interval is 500ms, so the preview updates shortly
  // after typing stops. The 100ms debounce coalesces rapid successive events.
  let reloadTimer: ReturnType<typeof setTimeout> | undefined
  window.addEventListener('message', (event) => {
    if (!isDocumentEvent(event, serverURL)) return
    if (reloadTimer) clearTimeout(reloadTimer)
    reloadTimer = setTimeout(() => {
      window.location.reload()
    }, 100)
  })
</script>
