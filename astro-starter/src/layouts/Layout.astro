---
import SeoHead from '@/components/shared/SeoHead.astro'
import Link from '@/components/Link.astro'
import FooterBlock from '@/components/FooterBlock/index.astro'
import { getHeader, getFooter, getMediaUrl } from '@/lib/payload'
import { SITE_CONFIG } from '@/content/site.config'

interface SEO {
  title?: string;
  description?: string;
  image?: { url?: string };
}

interface Props {
  title: string;
  description?: string;
  seo?: SEO;
}

const { title, description = "", seo } = Astro.props;

const seoTitle = seo?.title || title;
const seoDescription = seo?.description || description;
const seoImage = seo?.image?.url ? getMediaUrl(seo.image.url) : '';

const header = await getHeader();
const footer = await getFooter();
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <SeoHead title={seoTitle} description={seoDescription} imageUrl={seoImage} />
    <link rel='stylesheet' href='/styles/variables.css' />
    <link rel='stylesheet' href='/styles/global.css' />
  </head>
  <body>
    {
      (header?.logo ||
        (header?.navItems && header.navItems.length > 0) ||
        (header?.ctaText && header?.ctaLink)) && (
        <header>
          {header?.logo && (
            <a href="/" class='site-logo' aria-label={`${SITE_CONFIG.siteName} — inicio`}>
              <img
                src={getMediaUrl(header.logo.url)}
                alt={header.logo.alt?.trim() || SITE_CONFIG.siteName}
              />
            </a>
          )}
          {header?.navItems && header.navItems.length > 0 && (
            <nav aria-label='Principal'>
              {header.navItems.map((item) => (
                <Link link={item.link} />
              ))}
            </nav>
          )}
          {header?.ctaText && header?.ctaLink && (
            <a
              href={
                header.ctaLink.type === 'reference' &&
                typeof header.ctaLink.reference?.value === 'object' &&
                header.ctaLink.reference.value?.slug
                  ? `/${header.ctaLink.reference.value.slug}`
                  : header.ctaLink.url
              }
              class='site-cta'
              {...(header.ctaLink.newTab
                ? { rel: 'noopener noreferrer', target: '_blank' }
                : {})}
            >
              {header.ctaText}
            </a>
          )}
        </header>
      )
    }
    <main>
      <slot />
    </main>
    <FooterBlock
      navItems={footer?.navItems}
      copyright={footer?.copyright}
      socialLinks={footer?.socialLinks}
    />
  </body>
</html>
