---
import Hero from '@/heros/Hero.astro'
import TextBlock from '@/components/blocks/TextBlock.astro'
import ImageBlock from '@/components/blocks/ImageBlock.astro'
import ContactBlock from '@/components/blocks/ContactBlock.astro'
import MenuBlock from '@/components/blocks/MenuBlock.astro'
import CourseBlock from '@/components/blocks/CourseBlock.astro'

interface Props {
  hero?: Array<{ blockType: string; [key: string]: unknown }>
  layout: Array<{ blockType: string; [key: string]: unknown }>
}

const { hero, layout } = Astro.props

const allBlocks = [...(hero ?? []), ...layout]
---

<article>
  {
    allBlocks.map((block) => {
      switch (block.blockType) {
        case 'hero':
          return <Hero data={block} />
        case 'text':
          return <TextBlock data={block} />
        case 'image':
          return <ImageBlock data={block} />
        case 'contact':
          return <ContactBlock data={block} />
        case 'menu':
          return <MenuBlock data={block} />
        case 'course':
          return <CourseBlock data={block} />
        default:
          if (import.meta.env.DEV) {
            console.warn(`[BlockRenderer] Unknown block type: "${block.blockType}"`)
          }
          return null
      }
    })
  }
</article>
