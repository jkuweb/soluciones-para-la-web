---
import Link from '@/components/Link.astro'
import { getMediaUrl } from '@/lib/payload'
import type { HeroBlock } from '@/lib/types'

interface Props {
  data: HeroBlock
}

const { data } = Astro.props
const backgroundImage =
  data.backgroundImage?.sizes?.hero?.url || data.backgroundImage?.url || ''
const fullImageUrl = backgroundImage ? getMediaUrl(backgroundImage) : ''
---

<section
  class="hero-block"
  style={backgroundImage
    ? `background-image: url(${fullImageUrl}); background-size: cover; background-position: center;`
    : undefined}
>
  <div class="hero-block__content">
    <h1>{data.title}</h1>
    {data.subtitle && <p class="hero-block__subtitle">{data.subtitle}</p>}
    {data.information && <p class="hero-block__information">{data.information}</p>}
    {data.cta && data.cta.length > 0 && (
      <div class="hero-block__cta-group">
        {data.cta.map((item) => {
          const link = item.link
          if (!link?.label) return null
          return <Link link={link} className="hero-block__cta" />
        })}
      </div>
    )}
    {data.images && data.images.length > 0 && (
      <div class="hero-block__additional-images">
        {data.images.map((item) => {
          if (!item.image?.url) return null
          return (
            <img
              src={getMediaUrl(item.image.url)}
              alt={item.image.alt || ''}
              class="hero-block__additional-image"
            />
          )
        })}
      </div>
    )}
  </div>
</section>
