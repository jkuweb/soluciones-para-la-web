PAYLOAD_API_URL=http://localhost:3000/api
TENANT_SLUG=mi-tienda

# Used by /preview route to authenticate requests coming from the
# Payload admin live preview iframe. Must match agencia-backend/.env
# (PREVIEW_SECRET).
PREVIEW_SECRET=dev-preview-secret-change-in-production

# ── Stripe (payments feature) ──────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys (test mode for dev)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_CLIENT_ID=ca_...                          # for Stripe Connect OAuth
# STRIPE_OAUTH_STATE_SECRET=change-me-in-prod     # HMAC for OAuth state JWT
