# Database
DATABASE_URL=postgresql://localhost:5433/agencia_dev

# Payload Secret (generate with: openssl rand -hex 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Live preview — base host used by the admin live preview iframe.
# The port is rewritten per tenant from LIVE_PREVIEW_ASTRO_PORT /
# LIVE_PREVIEW_NEXTJS_PORT unless the tenant has its own devUrl set.
# Any tenant that overrides its own URL should set its `devUrl` field in the
# admin; the env vars are the default for tenants that haven't.
LIVE_PREVIEW_BASE_URL=http://localhost
LIVE_PREVIEW_ASTRO_PORT=4321
LIVE_PREVIEW_NEXTJS_PORT=3000

# Secret used by the admin live preview to authenticate draft fetches.
# The client starter must use the same value to call /api/pages/preview-page.
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# Cloudinary (optional - for media storage)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Stripe (optional - for payments / Sprint 2 feature)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
